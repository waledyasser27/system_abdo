rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidMenuItem(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100
          && data.price is number && data.price >= 0
          && data.category is string
          && data.stock is number;
    }

    function isValidOrder(data) {
      return data.orderNumber is number
          && data.items is list && data.items.size() > 0
          && data.total is number && data.total >= 0
          && data.status in ['pending', 'preparing', 'ready', 'delivered']
          && (data.customerPhone is string || data.customerPhone == null);
    }

    // --- Collection Matches ---

    // Menu
    match /menu/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(itemId) && isValidMenuItem(incoming());
      allow update: if isSignedIn() && isValidMenuItem(incoming());
      allow delete: if isSignedIn();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());
      allow update: if isSignedIn() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
    }

    // Staff
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(staffId);
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(customerId);
      allow update: if isSignedIn() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['loyaltyPoints', 'totalSpent', 'totalOrders', 'loyaltyTier'])
      );
    }

    // Reservations
    match /reservations/{resId} {
      allow read: if isSignedIn();
      allow create: if true; // Guests can reserve
      allow update: if isSignedIn();
    }

    // Suppliers
    match /suppliers/{supId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(supId);
    }

    // Settings
    match /settings/config {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
